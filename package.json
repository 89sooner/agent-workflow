{
  "name": "agent-workflow-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-frontend.mjs && node scripts/build-mission.mjs",
    "dev": "node scripts/build-frontend.mjs --watch",
    "check:vendor": "node scripts/build-frontend.mjs --check",
    "build:mission": "node scripts/build-mission.mjs",
    "dev:mission": "node scripts/build-mission.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check:mission": "node scripts/build-mission.mjs --check",
    "test:activity:browser": "WORKFLOW_NATIVE_SCENARIO=tests/activity_scenarios.mjs python3 tests/native_integration.py",
    "test:projects:browser": "WORKFLOW_NATIVE_SCENARIO=tests/project_spaces_scenarios.mjs python3 tests/native_integration.py",
    "test:evidence:browser": "WORKFLOW_NATIVE_SCENARIO=tests/session_evidence_scenarios.mjs python3 tests/native_integration.py",
    "test:metrics:browser": "WORKFLOW_NATIVE_SCENARIO=tests/session_metrics_scenarios.mjs python3 tests/native_integration.py",
    "test:bookmarks:browser": "WORKFLOW_NATIVE_SCENARIO=tests/bookmarks_scenarios.mjs python3 tests/native_integration.py",
    "test:hierarchy:browser": "WORKFLOW_NATIVE_SCENARIO=tests/session_hierarchy_scenarios.mjs python3 tests/native_integration.py",
    "test:notifications": "node scripts/test-notifications.mjs",
    "test:notifications:browser": "WORKFLOW_NATIVE_SCENARIO=tests/notifications_scenarios.mjs python3 tests/native_integration.py",
    "test:mission": "node scripts/test-mission.mjs && node scripts/test-attention.mjs && node scripts/test-notifications.mjs && node scripts/test-session-hierarchy.mjs && node scripts/test-activity.mjs"
  },
  "devDependencies": {
    "@react-three/fiber": "9.8.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "7.0.2"
  }
}
