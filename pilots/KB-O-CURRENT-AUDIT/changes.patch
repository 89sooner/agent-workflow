+});
+
+// ── 2. 음성 — ID 가 없으면 링크도 없고, 읽는 중 · 읽지 못함에는 과거 ID 가 남지 않는다 ────────────────────────────
+
+describe("[KB-O-CURRENT-AUDIT] no audit ID means no link, and no past ID survives a read in progress or a failed read", () => {
+  it.each<KillSwitchState>(["ON", "OFF", "UNKNOWN"])("%s without an audit ID keeps '변경 기록 없음' and renders no link", (state) => {
