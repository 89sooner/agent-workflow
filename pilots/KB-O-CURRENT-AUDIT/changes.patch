+ *    (`useOpsRisk` 의 `data = null` 흐름을 그대로 탄다).
+ *  · 링크는 읽기 전용 탐색이다 — 눌러도 제안 · 확정 · 재조회 · 어떤 쓰기 요청도 생기지 않고, 원래 탭의 입력 중 · 확인 중 상태가 그대로다.
+ *  · 결과 상자의 링크(`data-audit-of="original"` · `"retry"`)는 그대로이며 현재 상태의 것(`"current"`)과 자리가 다르다.
+ */
+import { describe, expect, it, vi } from "vitest";
+import { act, fireEvent, render, waitFor } from "@testing-library/react";
+import { RiskClient } from "../app/admin/risk/risk-client";
+import { AuthGate } from "../components/auth/AuthGate";
+import { KillSwitchPanel } from "../components/risk/KillSwitchPanel";
+import type { OpsApiResult } from "../lib/api/adapter";
+import type { KillSwitch, KillSwitchCommitResult, KillSwitchConfirmation, KillSwitchState, RiskGateState } from "../lib/api/types";
+import { RESULT_AUDIT_ACTION, auditListHref, parseAuditLink } from "../lib/audit/audit-link";
+import { loadingPanel, type PanelState } from "../lib/dashboard/model";
+import { STUB_RISK_SESSION, StubOpsApi, fail, fixtureHealth, fixtureRiskGate, fixtureSnapshot, ok, panelStatus, riskGateWith } from "./helpers";
+
+// ── 시험 도구 ──────────────────────────────────────────────────────────────────────────────────────
+
+class Deferred<T> {
+  readonly promise: Promise<T>;
+  resolve!: (value: T) => void;
+  constructor() {
+    this.promise = new Promise<T>((r) => { this.resolve = r; });
+  }
+}
+
+type Responder<T> = () => Promise<OpsApiResult<T>>;
+
+/** 게이트 읽기의 응답 순서와 시점을 정하는 어댑터 — 큐가 비면 `StubOpsApi` 의 기본 동작(`results.riskGate` · fixture)이다. */
+class GateQueueApi extends StubOpsApi {
+  readonly gateQueue: Responder<RiskGateState>[] = [];
+  async getRiskGate(opts?: { limit?: number | null }): Promise<OpsApiResult<RiskGateState>> {
+    const next = this.gateQueue.shift();
+    if (next === undefined) return super.getRiskGate(opts);
+    this.calls.riskGate.push(opts?.limit ?? null);
+    return next();
+  }
+}
+
+function immediate<T>(r: OpsApiResult<T>): Responder<T> {
+  return () => Promise.resolve(r);
+}
+
+function deferred<T>(): { responder: Responder<T>; resolve: (r: OpsApiResult<T>) => void } {
+  const d = new Deferred<OpsApiResult<T>>();
+  return { responder: () => d.promise, resolve: (r) => d.resolve(r) };
+}
+
+function stub(riskGate?: OpsApiResult<RiskGateState>) {
+  return new StubOpsApi({ health: ok(fixtureHealth), snapshot: ok(fixtureSnapshot), riskGate });
+}
+
+/** fixture 게이트(OFF · 버전 0 · 감사 ID 없음)에서 kill switch 만 바꾼 게이트 — 나머지는 fixture 그대로다(값을 지어내지 않는다). */
+function gate(state: KillSwitchState, over: Partial<KillSwitch> = {}): RiskGateState {
+  return riskGateWith({ killSwitch: { ...fixtureRiskGate.killSwitch, state, ...over } });
+}
+
+const ON_ID = "ks-current-on-01";
+const OFF_ID = "ks-current-off-02";
+const CURRENT_ON = gate("ON", { version: 2, reason: "OPERATOR_DRILL", updatedAt: "2026-10-07T09:00:00Z", updatedBy: "risk-one", auditId: ON_ID });
+const CURRENT_OFF = gate("OFF", { version: 3, updatedAt: "2026-10-07T10:00:00Z", updatedBy: "risk-two", auditId: OFF_ID });
+
+function ready(data: RiskGateState): PanelState<RiskGateState> {
+  return { status: "ready", data, failure: null, receivedAt: "2026-10-08T00:00:00Z" };
+}
+
+function unavailable(): PanelState<RiskGateState> {
+  return { status: "disconnected", data: null, failure: fail("disconnected"), receivedAt: null };
+}
+
+function confirmation(id: string, requestedState: "ON" | "OFF", expectedVersion: number): KillSwitchConfirmation {
+  return { confirmationId: id, requestedState, expectedVersion, expiresAt: "2026-10-08T00:05:00Z" };
+}
+
+function applied(auditId: string, before: KillSwitchState, after: KillSwitchState, vb: number, va: number): KillSwitchCommitResult {
+  return { outcome: "APPLIED", rejectReason: null, auditId, killSwitchBefore: before, killSwitchAfter: after, versionBefore: vb, versionAfter: va };
+}
+
+const CURRENT = "[data-region='current-state']";
+const q = (c: ParentNode, sel: string) => c.querySelector<HTMLElement>(sel);
+const currentRegion = (c: HTMLElement) => q(c, CURRENT)!;
+const currentField = (c: HTMLElement) => q(c, `${CURRENT} [data-field='auditId']`);
+const currentRef = (c: HTMLElement) => q(c, `${CURRENT} [data-audit-id][data-audit-of='current']`);
+const currentLink = (c: HTMLElement) => c.querySelector<HTMLAnchorElement>(`${CURRENT} a[data-testid='audit-ref-link']`);
+const btn = (c: HTMLElement, action: string) => c.querySelector<HTMLButtonElement>(`[data-action="killswitch-${action}"]`)!;
+const reasonInput = (c: HTMLElement) => c.querySelector<HTMLInputElement>("input[name='reason']")!;
+
+/** 결과 상자의 링크와 같은 계약 — 정확한 주소 · 새 탭 · 참조자 차단 · A-003 의 실제 파서가 받아들이는 조건 · 현재 상태 상자 안의 유일한 링크. */
+function expectCurrentLink(container: HTMLElement, auditId: string) {
+  expect(currentRef(container)?.textContent).toBe(auditId);
+  const link = currentLink(container);
+  expect(link).not.toBeNull();
+  const href = link!.getAttribute("href")!;
+  expect(href).toBe(auditListHref(RESULT_AUDIT_ACTION.killSwitch, auditId));
+  expect(href).toBe(`/admin/access?auditAction=KILL_SWITCH_CHANGE&auditId=${auditId}`);
+  expect(link!.getAttribute("data-audit-ref")).toBe(auditId);
+  expect(link!.getAttribute("target")).toBe("_blank");
+  const rel = (link!.getAttribute("rel") ?? "").split(/\s+/);
+  expect(rel).toContain("noopener");
+  expect(rel).toContain("noreferrer");
+  expect(parseAuditLink(new URL(href, "http://fixture.invalid").search)).toEqual({ kind: "ok", action: "KILL_SWITCH_CHANGE", auditId });
+  expect(currentField(container)?.contains(link)).toBe(true);
+  expect(currentRegion(container).querySelectorAll("a")).toHaveLength(1);   // 변경 시각 · 변경 주체 칸에는 링크가 생기지 않았다
+}
+
+/** 쓰기(조작) 호출 전부와 읽기 호출 — 링크 클릭 전후로 같아야 한다. */
+function calls(api: StubOpsApi): string {
+  const c = api.calls;
+  return JSON.stringify({
+    prepareKillSwitch: c.prepareKillSwitch, commitKillSwitch: c.commitKillSwitch,
+    prepareAccessChange: c.prepareAccessChange, commitAccessChange: c.commitAccessChange,
+    preparePolicyChange: c.preparePolicyChange, commitPolicyChange: c.commitPolicyChange,
+    auditCsvExport: c.auditCsvExport, performanceCsvExport: c.performanceCsvExport,
+    signIn: c.signIn, signOut: c.signOut, riskGate: c.riskGate, auditRecords: c.auditRecords,
+  });
+}
+
+/** 인증 셸 안의 실제 화면 — 세션은 `AuthGate` 가 Context 로 주고, 재조회는 실제 `useOpsRisk` 가 한다. */
+async function renderRiskScreen(api: StubOpsApi) {
+  const utils = render(<AuthGate api={api}><RiskClient api={api} limit={null} /></AuthGate>);
+  await waitFor(() => expect(q(utils.container, "[data-controls-enabled='true']")).not.toBeNull());
+  await waitFor(() => expect(q(utils.container, "[data-kill-switch-state]")).not.toBeNull());
